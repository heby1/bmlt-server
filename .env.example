# Local Docker configuration. Copy to .env; never put credentials in src/.env
# while building because upstream includes src/.env in its release archive.
APP_DEBUG=true
APP_KEY=
DB_DATABASE=rootserver
DB_USERNAME=rootserver
DB_PASSWORD=
DB_PREFIX=na
MARIADB_ROOT_PASSWORD=
BMLT_PORT=8000

NASUOMI_SOURCE_URL=https://www.nasuomi.org/wp-json/wp/v2/kokoukset
NASUOMI_ADMIN_USERNAME=serveradmin
NASUOMI_INITIAL_ADMIN_PASSWORD=
# Absolute host path; Compose expands PWD when run from the repository root.
# Docker overrides this to /var/lib/bmlt-nasuomi inside the application.
NASUOMI_STATE_DIR=${PWD}/var/nasuomi
NASUOMI_COORDINATE_OVERRIDES=
NASUOMI_SYNC_TIME=04:15
NASUOMI_SCHEDULE_ENABLED=false
