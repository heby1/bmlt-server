# Copy to bmltfi/.env on the server, then replace every REPLACE value.
# This template contains no credentials. Never commit the completed .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.nasuomi.org/bmltfi
ASSET_URL=https://www.nasuomi.org/bmltfi
APP_KEY=
COMMIT_SHA=REPLACE_WITH_RELEASE_COMMIT
LANGUAGE=fi
DISTANCE_UNITS=km
REGION_BIAS=fi
SEARCH_SPEC_MAP_CENTER_LATITUDE=64
SEARCH_SPEC_MAP_CENTER_LONGITUDE=26
SEARCH_SPEC_MAP_CENTER_ZOOM=5

# One empty SiteGround MySQL database, with its own user assigned to that DB.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DATABASE
DB_USERNAME=REPLACE_WITH_DATABASE_USER
DB_PASSWORD="REPLACE_WITH_DATABASE_PASSWORD"
DB_PREFIX=na

NASUOMI_SOURCE_URL=https://www.nasuomi.org/wp-json/wp/v2/kokoukset
NASUOMI_ADMIN_USERNAME=serveradmin
NASUOMI_INITIAL_ADMIN_PASSWORD="REPLACE_WITH_NEW_ADMIN_PASSWORD"
# An absolute directory outside public_html, writable by the hosting account.
NASUOMI_STATE_DIR=/REPLACE_WITH_PRIVATE_PATH/nasuomi-state
NASUOMI_COORDINATE_OVERRIDES=
NASUOMI_SYNC_TIME=04:15
# Enable after migrations, initialization, dry run and the first import succeed.
NASUOMI_SCHEDULE_ENABLED=false

# Optional failure/partial-import alerts. Blank disables sending.
NASUOMI_ALERT_EMAIL=
MAIL_FROM_ADDRESS=REPLACE_WITH_EXISTING_NASUOMI_MAILBOX
MAIL_FROM_NAME="NA Suomi meeting mirror"
# SiteGround's verified wrapper supports noninteractive -t mode.
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/bin/sendmail -t -i"
# Alternatively use an existing mailbox's verified SMTP settings:
# MAIL_MAILER=smtp
# MAIL_HOST=REPLACE_WITH_SMTP_HOST
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=REPLACE_WITH_MAILBOX
# MAIL_PASSWORD="REPLACE_WITH_MAILBOX_PASSWORD"
